generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  STAFF
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  MANUAL
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  FLAGGED
}

enum Plan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  businesses    Business[]           @relation("BusinessOwner")
  staffProfile  BusinessStaff?
  appointments  Appointment[]
  customerLinks Customer[]
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  resetTokens   PasswordResetToken[]

  @@index([role])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ServiceCategory {
  id         String     @id @default(cuid())
  slug       String     @unique
  name       String
  imageUrl   String
  sortOrder  Int        @default(0)
  active     Boolean    @default(true)
  services   Service[]
  businesses Business[]
}

model Business {
  id                  String         @id @default(cuid())
  slug                String         @unique
  name                String
  tagline             String?
  description         String         @default("")
  logoUrl             String?
  coverUrl            String?
  address             String         @default("")
  district            String         @default("")
  city                String         @default("Улаанбаатар")
  lat                 Float?
  lng                 Float?
  phone               String         @default("")
  email               String?
  instagram           String?
  facebook            String?
  website             String?
  status              BusinessStatus @default(PENDING)
  onboardingStep      Int            @default(1)
  onboardingCompleted Boolean        @default(false)
  ratingAvg           Float          @default(0)
  reviewCount         Int            @default(0)
  ownerId             String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  owner         User              @relation("BusinessOwner", fields: [ownerId], references: [id])
  categories    ServiceCategory[]
  staff         BusinessStaff[]
  services      Service[]
  appointments  Appointment[]
  workingHours  WorkingHour[]
  blockedTimes  BlockedTime[]
  customers     Customer[]
  reviews       Review[]
  favorites     Favorite[]
  gallery       BusinessGallery[]
  bookingRule   BookingRule?
  subscription  Subscription?
  payments      Payment[]

  @@index([status])
  @@index([district])
}

model BusinessStaff {
  id              String   @id @default(cuid())
  businessId      String
  userId          String?  @unique
  name            String
  title           String
  photoUrl        String?
  bio             String   @default("")
  experienceYears Int      @default(0)
  color           String   @default("#8a5a44")
  active          Boolean  @default(true)
  ratingAvg       Float    @default(0)
  reviewCount     Int      @default(0)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  services     Service[]
  appointments Appointment[]
  workingHours WorkingHour[]
  blockedTimes BlockedTime[]
  reviews      Review[]
  favorites    Favorite[]

  @@index([businessId])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  categoryId  String
  name        String
  description String   @default("")
  durationMin Int
  price       Int
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business     Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     ServiceCategory @relation(fields: [categoryId], references: [id])
  staff        BusinessStaff[]
  appointments Appointment[]

  @@index([businessId])
  @@index([categoryId])
}

/// Weekly schedule. staffId = null means business opening hours.
/// weekday: 0 = Monday ... 6 = Sunday. Times are "HH:MM" in Asia/Ulaanbaatar.
model WorkingHour {
  id         String  @id @default(cuid())
  businessId String
  staffId    String?
  weekday    Int
  openTime   String
  closeTime  String
  isClosed   Boolean @default(false)
  breakStart String?
  breakEnd   String?

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    BusinessStaff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([businessId, staffId, weekday])
  @@index([businessId, weekday])
}

model BlockedTime {
  id         String   @id @default(cuid())
  businessId String
  staffId    String?
  startAt    DateTime
  endAt      DateTime
  reason     String   @default("")
  createdAt  DateTime @default(now())

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    BusinessStaff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([businessId, startAt])
}

/// CRM record: one row per person per business.
model Customer {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  name       String
  phone      String
  email      String?
  note       String   @default("")
  createdAt  DateTime @default(now())

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id])
  appointments Appointment[]

  @@unique([businessId, phone])
  @@index([userId])
}

model Appointment {
  id           String            @id @default(cuid())
  code         String            @unique
  businessId   String
  serviceId    String
  staffId      String
  customerId   String
  userId       String?
  startAt      DateTime
  endAt        DateTime
  price        Int
  status       AppointmentStatus @default(CONFIRMED)
  source       AppointmentSource @default(ONLINE)
  note         String            @default("")
  cancelReason String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  business Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service       @relation(fields: [serviceId], references: [id])
  staff    BusinessStaff @relation(fields: [staffId], references: [id])
  customer Customer      @relation(fields: [customerId], references: [id])
  user     User?         @relation(fields: [userId], references: [id])
  review   Review?

  @@index([businessId, startAt])
  @@index([staffId, startAt])
  @@index([userId, startAt])
  @@index([customerId])
}

model Review {
  id            String       @id @default(cuid())
  businessId    String
  staffId       String?
  appointmentId String?      @unique
  userId        String
  rating        Int
  comment       String       @default("")
  status        ReviewStatus @default(VISIBLE)
  createdAt     DateTime     @default(now())

  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff       BusinessStaff? @relation(fields: [staffId], references: [id])
  appointment Appointment?   @relation(fields: [appointmentId], references: [id])
  user        User           @relation(fields: [userId], references: [id])

  @@index([businessId, status])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  businessId String?
  staffId    String?
  createdAt  DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  staff    BusinessStaff? @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@unique([userId, staffId])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  channel   NotificationChannel @default(IN_APP)
  dedupeKey String?             @unique
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model BusinessGallery {
  id         String   @id @default(cuid())
  businessId String
  imageUrl   String
  caption    String   @default("")
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BookingRule {
  id                 String  @id @default(cuid())
  businessId         String  @unique
  minLeadMinutes     Int     @default(60)
  maxAdvanceDays     Int     @default(30)
  cancelWindowHours  Int     @default(3)
  cancellationPolicy String  @default("")
  slotStepMin        Int     @default(30)
  bufferMin          Int     @default(0)
  autoConfirm        Boolean @default(true)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Subscription {
  id               String             @id @default(cuid())
  businessId       String             @unique
  plan             Plan               @default(FREE)
  status           SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payments Payment[]
}

model Payment {
  id             String        @id @default(cuid())
  businessId     String
  subscriptionId String?
  plan           Plan
  amount         Int
  currency       String        @default("MNT")
  status         PaymentStatus @default(PENDING)
  provider       String        @default("demo")
  providerRef    String?
  createdAt      DateTime      @default(now())
  paidAt         DateTime?

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])

  @@index([businessId])
}

model PlatformSetting {
  key   String @id
  value String
}
