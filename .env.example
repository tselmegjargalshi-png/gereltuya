# PostgreSQL connection used by the app at runtime (pooled connection on Supabase/Neon).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct (non-pooled) connection used by Prisma for schema changes.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public base URL, used for SEO, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional providers. Leave empty to use the built-in demo implementations.
CRON_SECRET=""           # optional, protects /api/cron/maintenance
SMS_PROVIDER=""          # e.g. "messagepro" or "twilio" once integrated
EMAIL_PROVIDER=""        # e.g. "resend" once integrated
PAYMENT_PROVIDER=""      # e.g. "qpay" once integrated

# Optional: Vercel Blob token enables image upload for logos, covers, gallery and staff photos.
# Without it owners can paste image URLs instead.
BLOB_READ_WRITE_TOKEN=""
